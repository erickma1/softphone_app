  Future<void> _applyReferralCodeFromTopUp() async {
    final code = _referralCodeController.text.trim().toUpperCase();

    if (code.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('Please enter referral code')),
      );
      return;
    }

    setState(() {
      _isApplyingReferralCode = true;
      _referralMessage = '';
    });

    final result = await AuthService.applyReferralCode(code);

    if (!mounted) return;

    final referral = result['referral'];

    setState(() {
      _isApplyingReferralCode = false;

      if (result['success'] == true && referral is Map<String, dynamic>) {
        _referralStatus = referral;
        _referralCodeController.clear();
      }

      _referralMessage =
          result['message']?.toString() ?? 'Referral request completed';
    });

    ScaffoldMessenger.of(
      context,
    ).showSnackBar(SnackBar(content: Text(_referralMessage)));
  }

